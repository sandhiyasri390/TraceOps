# TraceOps Backend Environment Configuration
# Copy this file to .env to override defaults if necessary.

ENVIRONMENT=development
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Exasol Connection Configuration
# Default connects to local Exasol Personal instance
EXASOL_DSN=127.0.0.1:8563
EXASOL_USER=sys
# Optional: if EXASOL_PASSWORD is not set, it will be automatically read from:
# %USERPROFILE%\.exasol-starter-kit\credentials\personal_sys_password
# EXASOL_PASSWORD=your_password_here
EXASOL_SCHEMA=
EXASOL_ENCRYPTION=True
# Allow self-signed certificate for local development (set to False for production with valid CA)
EXASOL_ALLOW_SELF_SIGNED=True
